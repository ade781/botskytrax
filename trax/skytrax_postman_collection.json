{
  "info": {
    "name": "Skytrax World Airport Survey Testing",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Collection otomatis untuk testing submit form Skytrax World Airport Survey (Get CSRF Token + Submit Form).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get CSRF Token & Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.csrf_token) {",
              "    pm.collectionVariables.set('csrf_token', res.csrf_token);",
              "    console.log('CSRF Token saved:', res.csrf_token);",
              "}",
              "pm.test('CSRF token berhasil diambil', function () {",
              "    pm.expect(res.csrf_token).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Referer",
            "value": "https://www.worldairportsurvey.com/Surveys/Airport/form.html",
            "type": "text"
          },
          {
            "key": "X-Requested-With",
            "value": "XMLHttpRequest",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://www.worldairportsurvey.com/Surveys/Airport/admin.php?method=csrfToken",
          "protocol": "https",
          "host": [
            "www",
            "worldairportsurvey",
            "com"
          ],
          "path": [
            "Surveys",
            "Airport",
            "admin.php"
          ],
          "query": [
            {
              "key": "method",
              "value": "csrfToken"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Submit Airport Survey Form",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Otomatis ambil CSRF token terbaru sebelum POST dikirim",
              "pm.sendRequest({",
              "    url: 'https://www.worldairportsurvey.com/Surveys/Airport/admin.php?method=csrfToken',",
              "    method: 'GET',",
              "    header: {",
              "        'Referer': 'https://www.worldairportsurvey.com/Surveys/Airport/form.html',",
              "        'X-Requested-With': 'XMLHttpRequest'",
              "    }",
              "}, function (err, res) {",
              "    if (!err && res) {",
              "        const data = res.json();",
              "        if (data && data.csrf_token) {",
              "            pm.collectionVariables.set('csrf_token', data.csrf_token);",
              "            console.log('Auto-fetched csrf_token:', data.csrf_token);",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log('Response body:', pm.response.text());",
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
